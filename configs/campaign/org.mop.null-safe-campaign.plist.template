<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.mop.null-safe-campaign</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MOP_REPO_ROOT__/.venv/bin/python</string>
    <string>__MOP_REPO_ROOT__/scripts/plan_campaign_recovery.py</string>
    <string>resume</string>
    <string>--config</string>
    <string>__MOP_REPO_ROOT__/configs/campaign/mac_studio_substrate_null_safe_router.json</string>
    <string>--execute</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MOP_REPO_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__MOP_REPO_ROOT__/runs/recovery-launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__MOP_REPO_ROOT__/runs/recovery-launchd.stderr.log</string>
</dict>
</plist>
