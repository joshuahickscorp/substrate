# durability: track the load-bearing verdict evidence in place (the rest of runs/ stays ignored).
# git cannot re-include a file whose parent dir is excluded, so re-include the dirs, re-exclude their
# contents, then re-include the specific curated files. See STUDIO_RUN_REPORT.md durability note.
!runs/
runs/*
# Historical receipts are already tracked and remain in Git through the migration manifest. New mutable
# state is admitted only under the active Substrate run root.
!runs/substrate/
runs/substrate/*
!runs/substrate/v1/
runs/substrate/v1/*
!runs/substrate/v1/result_ledger.json
!runs/substrate/v1/experiments/
!runs/substrate/v1/experiments/**

# Final-revision supplementary receipts. These are post-freeze checks, not
# required deliverables, but published documents cite them by path, so they must
# exist for a reader of a clean clone. The scripts are tracked beside their
# receipts so a reviewer can re-run them rather than take the JSON on its word.
!runs/substrate/final_revision/
runs/substrate/final_revision/*
!runs/substrate/final_revision/instrument_liveness_check.json
!runs/substrate/final_revision/instrument_liveness_check.py
!runs/substrate/final_revision/independent_rerun_check.json
!runs/substrate/final_revision/continuity_receipt_consistency.py
!runs/substrate/final_revision/continuity_receipt_consistency.json
!runs/substrate/final_revision/cleanclone_verify_frozen_afeb.json
!runs/substrate/final_revision/cleanclone_regen_frozen_afeb.json
!runs/substrate/final_revision/collect_campaign_evidence.py
!runs/substrate/final_revision/blocker_batch_1.json
!runs/substrate/final_revision/blocker_batch_2.json
!runs/substrate/final_revision/terminal_handoff_20260728.md

!runs/pre_studio/
runs/pre_studio/*
!runs/pre_studio/close_e7_sparse.json
!runs/pre_studio/close_ex5_local_rules.json
!runs/pre_studio/close_ex2_planning.json
!runs/pre_studio/close_b5_degeneracy.json
!runs/pre_studio/frozen_random_census.json
!runs/pre_studio/census_reaudit.json
!runs/pre_studio/RESULTS_PRE_STUDIO.md
!runs/mot/
runs/mot/*
!runs/mot/dr13_predictor_fidelity.json

# model weights and local AI go-prompt
*.pt
*.pth
*.safetensors
*.bin
**/.DS_Store
GO.md

# Accretion Collapse scratch working area
.collapse/

# Execution Forge isolated benchmark roots are disposable; only the sealed matrix and reports are tracked.
artifacts/substrate/execution-forge/.benchmark-*/
