      "must_record_and_account_for": [
        "calendar_order",
        "host_aging",
        "software_drift",
        "model_service_drift",
        "environmental_differences",
        "operator_interventions"
      ],
      "aggregation_valid_only_if": [
        "model_identity_matches_frozen_pin",
        "runtime_identity_matches_frozen_pin",
        "candidate_control_tool_and_scoring_identities_match_frozen_pins",
        "anchor_canary_drift_is_within_frozen_tolerance"
      ],
      "aggregation_invalidated_if": [
        "model_or_runtime_identity_changes",
        "anchor_canary_behavior_exceeds_frozen_tolerance",
        "critical_cross_wave_drift_is_detected"
      ]
    }
  },
  "blindness_and_order_controls": {
