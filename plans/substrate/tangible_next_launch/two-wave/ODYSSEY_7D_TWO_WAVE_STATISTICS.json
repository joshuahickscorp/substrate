    "candidate_control_matching": [
      "task_schedule",
      "allowed_observations",
      "base_model",
      "tools",
      "token_or_instruction_budget",
      "compute_ceiling",
      "storage_ceiling",
      "wall_time",
      "stimulus_family",
      "scoring_rubric"
    ],
