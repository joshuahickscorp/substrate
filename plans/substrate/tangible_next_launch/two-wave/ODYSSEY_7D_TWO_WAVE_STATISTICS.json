    "weights": {
      "task_utility": 0.25,
      "developmental_retention_or_transfer": 0.25,
      "epistemic_integrity": 0.25,
      "resource_adjusted_continuity": 0.25
    },
    "weight_change_after_wave_1_begins_permitted": false,
    "primary_practical_threshold": {
      "metric": "paired standardized frontier effect",
      "value": 0.05,
      "operator": "greater_than_or_equal",
      "status": "draft_value_must_be_bound_by_G11_before_wave_1",
      "result_dependent_change_permitted": false
    },
    "day_7_cold_retention": {
      "new_instruction_permitted": false,
