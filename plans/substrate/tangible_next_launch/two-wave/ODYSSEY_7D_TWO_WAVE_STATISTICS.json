    }
  },
  "analysis": {
    "primary_methods": [
      "per_frontier_paired_standardized_effect",
      "mean_paired_effect_across_eight_frontier_blocks",
      "median_paired_effect_across_eight_frontier_blocks",
      "exact_sign_flip_randomization_test_over_frontier_blocks",
      "bootstrap_interval_over_frontier_blocks"
    ],
    "secondary_methods": [
      "clustered_repeated_measurement_model_with_frontier_block_clustering",
      "descriptive_by_frontier_and_by_wave_report"
    ],
    "prohibited_methods": [
      "treating_wave_1_and_wave_2_as_independent_experiments",
      "treating_within_history_events_as_independent_frontier_replications",
      "result_dependent_task_or_weight_selection",
      "unblinding_wave_1_scores_to_change_wave_2"
